# Copy this file to .env.local and fill in real values. Never commit .env.local.
# Get these from your Supabase project dashboard -> Project Settings -> API.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# "Publishable" key (new naming; functionally the same as the legacy "anon" key
# for createBrowserClient/createServerClient). Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Used for redirect URLs in emails (invite / password reset) when there is no
# request "origin" header to read from (e.g. running scripts/invite-owner.ts).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SERVER-ONLY. Full admin access, bypasses RLS. Never expose to the browser,
# never prefix with NEXT_PUBLIC_. Used only in src/lib/supabase/admin.ts and
# scripts/invite-owner.ts.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# SERVER-ONLY. The admin area's URL segment: only https://yourapp.com/<this>/login
# resolves (anything else 404s). Pick something long and unguessable, e.g. a
# random 24+ character string. Not linked from any page — share it with the
# Fydback team out of band.
ADMIN_ROUTE_SECRET=change-me-to-a-long-random-string

# SERVER-ONLY. From resend.com -> API Keys. Without this set, sendEmail()
# logs a warning and skips sending (no crash) — safe to leave unset in early
# local dev.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# The "From" address for all app-sent emails (prize-winner notifications,
# demo-request confirmations). Defaults to Resend's shared test sender
# (onboarding@resend.dev) if unset — works immediately with zero setup, but
# only looks professional once you verify your own domain in Resend and set
# this to e.g. "Fydback <hello@fydback.hu>".
EMAIL_FROM=Fydback <hello@fydback.hu>

# Optional: if set, a copy of every new demo request is emailed here too.
ADMIN_NOTIFICATION_EMAIL=you@fydback.hu

# SERVER-ONLY. Shared secret for the nightly prize-draw cron
# (/api/cron/daily-draw, scheduled in vercel.json). Vercel Cron sends it as
# "Authorization: Bearer <value>", but Vercel does NOT generate the value: you
# must set CRON_SECRET yourself in the project's Environment Variables
# (Production, type Secret), e.g. `openssl rand -hex 32`, and redeploy. Locally,
# set it too if you want to trigger the route by hand. Without it the route
# refuses to run rather than executing unprotected — it issues real coupons and
# emails real guests, so an open URL would let anyone drain a day's draw.
CRON_SECRET=change-me-to-a-long-random-string

# SERVER-ONLY. The one account allowed to remove other admin accounts (Adminok
# tab in Beállítások). Deliberately an env var, not a database role/flag: any
# admin already has UPDATE on profiles, so a DB-stored flag could grant itself
# to any admin session — an env var can only be changed by whoever controls
# these Vercel project settings, entirely outside the app's own reach. Leave
# unset to disable admin deletion for everyone.
SUPER_ADMIN_EMAIL=valentinver87@gmail.com
